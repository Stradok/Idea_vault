# Copy to supabase/functions/.env for local development (supabase functions serve)
# In production, set these with: supabase secrets set PERPLEXITY_API_KEY=... (etc.)
# SUPABASE_URL and SUPABASE_ANON_KEY are provided automatically by Supabase.

PERPLEXITY_API_KEY=your_perplexity_key_from_https://www.perplexity.ai/settings/api
GEMINI_API_KEY=your_gemini_key_from_https://aistudio.google.com/apikey
NEWSAPI_KEY=your_newsapi_key_from_https://newsapi.org
GNEWS_KEY=your_gnews_key_from_https://gnews.io
