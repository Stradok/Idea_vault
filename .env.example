# Copy this file to .env and fill in your Supabase project values.
# Get them from: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application type). Used as the `serverClientId` for Google Sign-In so
# the app can request an ID token Supabase accepts, and a Drive-scoped access
# token. Must also be set as the Client ID for Supabase's Google provider.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
